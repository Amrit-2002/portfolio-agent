# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=portfolio-rag-3072

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=models/gemini-embedding-2-preview

# GitHub Integration (for crawling projects, READMEs, and latest updates)
GITHUB_USERNAME=Amrit-2002
# GITHUB_TOKEN is optional (increases GitHub API limit from 60 to 5,000 requests/hr)
GITHUB_TOKEN=your-optional-github-personal-access-token

# Rate Limiting (max requests per minute per IP for /ask and /ask-stream)
RATE_LIMIT_PER_MINUTE=10

# Portfolio Source URL
PORTFOLIO_URL=https://amrit-2002.github.io/Portfolio/

# LangSmith (optional — for tracing) — https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key

# Flask / backend URLs (optional — defaults shown)
PORT=5070
FASTAPI_GRAPHQL_URL=http://localhost:8000/v1/graphql
FASTAPI_STREAM_URL=http://localhost:8000/v1/stream
PYTHON_VERSION=3.12.10
